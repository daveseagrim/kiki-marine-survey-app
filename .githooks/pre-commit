#!/bin/bash
# ============================================================================
# pre-commit — enforce process on every commit
# ============================================================================
# This hook runs automatically before "git commit" succeeds. If any check
# fails, the commit is blocked and you see the error.
#
# To enable this hook after cloning, run (once):
#   git config core.hooksPath .githooks
#
# Checks (in order):
#   1. All unit tests pass — if Node.js is installed.
#      If Node is not installed, tests are skipped with a warning. The
#      hook does NOT block commits in that case because the developer's
#      Claude session will have run the tests in its own sandbox before
#      giving the commit command.
#   2. APP_VERSION, CACHE_NAME, and cache-busters all match (bash-only,
#      always runs).
#   3. CHANGELOG has an entry for the current version (bash-only,
#      always runs).
# ============================================================================

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Git hooks run with a stripped-down PATH. Prepend common install locations
# so `node` is findable if it's installed.
export PATH="/opt/homebrew/bin:/usr/local/bin:/opt/local/bin:$HOME/.nvm/versions/node/current/bin:$HOME/.volta/bin:$HOME/.asdf/shims:$HOME/.local/bin:$PATH"

# If nvm is installed, source it so the default node is on PATH
if [ -z "$(command -v node 2>/dev/null)" ] && [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.nvm/nvm.sh" > /dev/null 2>&1 || true
fi

# ── 1. TESTS (if node is available) ─────────────────────────────────────
if command -v node > /dev/null 2>&1; then
  echo "▶ pre-commit: running tests…"
  if ! node tests/run_tests.js > /tmp/kiki_test_output.log 2>&1; then
    echo ""
    echo "✗ COMMIT BLOCKED — tests failed. Fix them before committing."
    echo ""
    tail -30 /tmp/kiki_test_output.log
    echo ""
    echo "To run tests manually: node tests/run_tests.js"
    exit 1
  fi
  TESTS_PASSED=$(grep -oE "[0-9]+ tests? passed" /tmp/kiki_test_output.log | head -1)
  echo "  ✓ $TESTS_PASSED"
else
  echo "▶ pre-commit: skipping tests — Node.js not installed locally."
  echo "  (Tests are expected to have been run in your Claude session's"
  echo "   sandbox before this commit. Install Node later with 'brew install"
  echo "   node' to enable automatic pre-commit testing on this machine.)"
fi

# ── 2. VERSION CONSISTENCY (bash, always runs) ──────────────────────────
echo "▶ pre-commit: checking versions…"
if ! bash scripts/check_versions.sh > /tmp/kiki_version_output.log 2>&1; then
  echo ""
  echo "✗ COMMIT BLOCKED — version mismatch."
  echo ""
  cat /tmp/kiki_version_output.log
  echo ""
  echo "Fix: run scripts/release.sh to bump everything atomically,"
  echo "or edit app.js, sw.js, and index.html so the versions agree."
  echo "Then add a CHANGELOG.md entry for the new version."
  exit 1
fi
echo "  ✓ versions match"

echo "▶ pre-commit: all checks passed"
